# ============================================================
# Embedding 模型配置（RAG 用）
# ============================================================
# 可选: "openai" | "default"
# "openai"  → 用 OpenAI text-embedding-3-small（需设 OPENAI_API_KEY，中文效果好）
# "default" → ChromaDB 内置 all-MiniLM-L6-v2（无需 API key，开箱即用，中文效果一般）
EMBEDDING_PROVIDER=default

# OpenAI API Key（仅当 EMBEDDING_PROVIDER=openai 时需要）
OPENAI_API_KEY=sk-your-key-here

# OpenAI Embedding 模型（可选，默认 text-embedding-3-small）
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# DeepSeek LLM 配置（Agent 用）
# ============================================================
# DeepSeek API Key（必填，在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# DeepSeek API Base URL（一般不需要改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型（可选）
# deepseek-chat    → 通用对话，速度快，适合大部分场景
# deepseek-reasoner → 深度思考，适合复杂分析，速度较慢
DEEPSEEK_MODEL=deepseek-chat
